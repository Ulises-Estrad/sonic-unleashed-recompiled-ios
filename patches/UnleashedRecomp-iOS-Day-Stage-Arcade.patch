+                    std::chrono::steady_clock::now().time_since_epoch()).count();
+                const int count = std::fprintf(g_diagnosticFile, "%lld [%d] %s: %.*s\n",
+                    static_cast<long long>(milliseconds), static_cast<int>(type),
+                    func ? func : "*", static_cast<int>(str.size()), str.data());
+                if (count > 0)
+                    g_diagnosticBytes += static_cast<size_t>(count);
+                std::fflush(g_diagnosticFile);
