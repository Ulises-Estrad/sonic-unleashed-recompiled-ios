diff --git a/tools/bundle_ios_game_data.py b/tools/bundle_ios_game_data.py
new file mode 100644
index 0000000..f35de67
--- /dev/null
+++ b/tools/bundle_ios_game_data.py
@@ -0,0 +1,104 @@
+"""Stage and verify self-contained Unleashed Recompiled iOS game data."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import shutil
+import zipfile
+
+
+DIRECTORIES = ("game", "update", "dlc", "patched", "save")
+REQUIRED_FILES = (
+    "game/default.xex",
+    "game/shader.ar",
+    "update/default.xexp",
+    "patched/default.xex",
+    "save/SYS-DATA",
+)
+MANIFEST_NAME = "BundledGameData-manifest.json"
+
+
+def digest_file(path: Path) -> str:
+    with path.open("rb") as stream:
+        return hashlib.file_digest(stream, "sha256").hexdigest()
+
+
+def validate_source(source: Path) -> None:
+    for directory in DIRECTORIES:
+        if not (source / directory).is_dir():
+            raise ValueError(f"Missing game-data directory: {source / directory}")
+    for name in REQUIRED_FILES:
+        if not (source / name).is_file():
+            raise ValueError(f"Missing required game-data file: {source / name}")
+
+
+def stage(source: Path, app: Path) -> None:
+    source = source.resolve()
+    app = app.resolve()
+    validate_source(source)
+
+    destination = app / "GameData"
+    if destination.exists():
+        raise ValueError(f"Refusing to overwrite existing bundled data: {destination}")
+
+    manifest: dict[str, str] = {}
+    for directory in DIRECTORIES:
+        source_directory = source / directory
+        for source_file in sorted(path for path in source_directory.rglob("*") if path.is_file()):
+            relative = source_file.relative_to(source)
+            destination_file = destination / relative
+            destination_file.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copy2(source_file, destination_file)
+            manifest[relative.as_posix()] = digest_file(destination_file)
+
+    if not manifest:
+        raise ValueError("No game data was staged")
+
+    (app / MANIFEST_NAME).write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
+    print(f"Bundled {len(manifest)} verified files in {destination}")
+
+
+def verify_ipa(ipa: Path) -> None:
+    with zipfile.ZipFile(ipa) as archive:
+        app_roots = {
+            name.split("/", 2)[1]
+            for name in archive.namelist()
+            if name.startswith("Payload/") and name.count("/") >= 2 and ".app/" in name
+        }
+        if len(app_roots) != 1:
+            raise ValueError(f"Expected one app bundle in IPA, found: {sorted(app_roots)}")
+
+        prefix = f"Payload/{next(iter(app_roots))}/"
+        manifest = json.loads(archive.read(prefix + MANIFEST_NAME))
+        if not manifest:
+            raise ValueError("Bundled game-data manifest is empty")
+
+        for name, expected in manifest.items():
+            with archive.open(prefix + "GameData/" + name) as stream:
+                actual = hashlib.file_digest(stream, "sha256").hexdigest()
+            if actual != expected:
+                raise ValueError(f"IPA game-data mismatch: {name}")
+
+    print(f"IPA verified: {len(manifest)} bundled files match the SHA-256 manifest")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path)
+    parser.add_argument("--app", type=Path)
+    parser.add_argument("--verify-ipa", type=Path)
+    args = parser.parse_args()
+
+    if args.verify_ipa:
+        verify_ipa(args.verify_ipa)
+    elif args.source and args.app:
+        stage(args.source, args.app)
+    else:
+        parser.error("Use --source with --app, or --verify-ipa")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/package_ios_ipa.sh b/tools/package_ios_ipa.sh
new file mode 100755
index 0000000..6e5eaf0
--- /dev/null
+++ b/tools/package_ios_ipa.sh
@@ -0,0 +1,109 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+BUILD_DIR="$ROOT/out/build/ios-device-release"
+STAGING_DIR="$ROOT/out/ipa-staging"
+APP_PATH="$BUILD_DIR/UnleashedRecomp/Unleashed Recompiled iOS.app"
+IPA_PATH="$ROOT/out/Unleashed-DualSense-Touch.ipa"
+JOBS="${JOBS:-$(sysctl -n hw.logicalcpu 2>/dev/null || printf '8')}"
+
+for tool in cmake python3 zip; do
+    if ! command -v "$tool" >/dev/null 2>&1; then
+        printf 'Required build tool is missing: %s\n' "$tool" >&2
+        exit 1
+    fi
+done
+
+if [[ -n "${GAME_DATA_ROOT:-}" ]]; then
+    mkdir -p "$ROOT/UnleashedRecompLib/private"
+    cp "$GAME_DATA_ROOT/game/default.xex" "$ROOT/UnleashedRecompLib/private/default.xex"
+    cp "$GAME_DATA_ROOT/update/default.xexp" "$ROOT/UnleashedRecompLib/private/default.xexp"
+    cp "$GAME_DATA_ROOT/game/shader.ar" "$ROOT/UnleashedRecompLib/private/shader.ar"
+fi
+
+missing=0
+for file in default.xex default.xexp shader.ar; do
+    if [[ ! -f "$ROOT/UnleashedRecompLib/private/$file" ]]; then
+        printf 'Missing private build input: %s\n' "$ROOT/UnleashedRecompLib/private/$file" >&2
+        missing=1
+    fi
+done
+
+if [[ "$missing" -ne 0 ]]; then
+    printf 'Set GAME_DATA_ROOT to the prepared iOS user-data directory or copy your own compatible files into UnleashedRecompLib/private.\n' >&2
+    exit 1
+fi
+
+cmake --preset ios-device-release \
+    -DSDL2MIXER_VORBIS=VORBISFILE \
+    -DUNLEASHED_RECOMP_DAY_STAGE_ARCADE=ON
+cmake --build "$BUILD_DIR" --target UnleashedRecomp -j "$JOBS"
+
+if [[ ! -d "$APP_PATH" ]]; then
+    printf 'Expected app bundle was not produced: %s\n' "$APP_PATH" >&2
+    exit 1
+fi
+
+case "$STAGING_DIR" in
+    "$ROOT"/out/*) ;;
+    *)
+        printf 'Unsafe staging path: %s\n' "$STAGING_DIR" >&2
+        exit 1
+        ;;
+esac
+
+rm -rf -- "$STAGING_DIR"
+mkdir -p "$STAGING_DIR/Payload" "$(dirname "$IPA_PATH")"
+cp -R "$APP_PATH" "$STAGING_DIR/Payload/"
+
+STAGED_APP="$STAGING_DIR/Payload/$(basename "$APP_PATH")"
+
+if [[ "${BUNDLE_GAME_DATA:-0}" == "1" ]]; then
+    if [[ -z "${GAME_DATA_ROOT:-}" ]]; then
+        printf 'BUNDLE_GAME_DATA=1 requires GAME_DATA_ROOT.\n' >&2
+        exit 1
+    fi
+
+    python3 "$ROOT/tools/bundle_ios_game_data.py" \
+        --source "$GAME_DATA_ROOT" \
+        --app "$STAGED_APP"
+fi
+
+if [[ -n "${CODESIGN_IDENTITY:-}" ]]; then
+    if [[ -n "${MOBILEPROVISION:-}" ]]; then
+        if [[ ! -f "$MOBILEPROVISION" ]]; then
+            printf 'Provisioning profile was not found: %s\n' "$MOBILEPROVISION" >&2
+            exit 1
+        fi
+        cp "$MOBILEPROVISION" "$STAGED_APP/embedded.mobileprovision"
+    fi
+
+    if [[ -d "$STAGED_APP/Frameworks/MoltenVK.framework" ]]; then
+        codesign --force --sign "$CODESIGN_IDENTITY" "$STAGED_APP/Frameworks/MoltenVK.framework"
+    fi
+
+    codesign_args=(--force --sign "$CODESIGN_IDENTITY")
+    if [[ -n "${ENTITLEMENTS:-}" ]]; then
+        codesign_args+=(--entitlements "$ENTITLEMENTS")
+    fi
+    codesign "${codesign_args[@]}" "$STAGED_APP"
+else
+    printf 'Applying an ad-hoc signature; your sideloading tool must re-sign the IPA on import.\n' >&2
+    if [[ -d "$STAGED_APP/Frameworks/MoltenVK.framework" ]]; then
+        codesign --force --sign - --timestamp=none "$STAGED_APP/Frameworks/MoltenVK.framework"
+    fi
+    codesign --force --sign - --timestamp=none "$STAGED_APP"
+fi
+
+rm -f -- "$IPA_PATH"
+(
+    cd "$STAGING_DIR"
+    zip -qry "$IPA_PATH" Payload
+)
+
+if [[ "${BUNDLE_GAME_DATA:-0}" == "1" ]]; then
+    python3 "$ROOT/tools/bundle_ios_game_data.py" --verify-ipa "$IPA_PATH"
+fi
+
+printf '%s\n' "$IPA_PATH"
