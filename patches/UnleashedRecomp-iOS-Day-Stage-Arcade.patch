+
+static void LogIOSFileOpen(const std::string_view requestedPath,
+    const std::filesystem::path& resolvedPath, bool succeeded, int openErrno)
+{
+    if (succeeded)
+    {
+        const size_t splitMarker = requestedPath.rfind(".ar.");
+        const bool isArchiveSplit = splitMarker != std::string_view::npos &&
+            requestedPath.size() == splitMarker + 6 &&
+            requestedPath[splitMarker + 4] >= '0' && requestedPath[splitMarker + 4] <= '9' &&
+            requestedPath[splitMarker + 5] >= '0' && requestedPath[splitMarker + 5] <= '9';
+        if (!isArchiveSplit && !requestedPath.ends_with(".ar") &&
+            !requestedPath.ends_with(".arl") && !requestedPath.ends_with(".sfd") &&
+            !requestedPath.ends_with(".xml"))
+            return;
+    }
+
+    static std::mutex logMutex;
+    static std::unordered_set<std::string> failedPaths;
+    static std::unordered_set<std::string> openedArchivePaths;
+    {
+        std::lock_guard lock(logMutex);
+        auto& paths = succeeded ? openedArchivePaths : failedPaths;
+        if (paths.size() >= 256 || !paths.emplace(requestedPath).second)
+            return;
+    }
+
+    // Logging can take its own locks; never call it while holding logMutex.
+    const auto hostPath = resolvedPath.u8string();
+    if (succeeded)
+    {
+        LOGF_IMPL(Utility, "iOS File I/O", "Opened archive/movie: guest=\"{}\" host=\"{}\"",
+            requestedPath, reinterpret_cast<const char*>(hostPath.c_str()));
+    }
+    else
+    {
+        LOGF_IMPL(Warning, "iOS File I/O", "File open failed: guest=\"{}\" host=\"{}\" errno={}",
+            requestedPath, reinterpret_cast<const char*>(hostPath.c_str()), openErrno);
+    }
+}
+#endif
+
