diff --git a/UnleashedRecomp/ui/touch_controls.cpp b/UnleashedRecomp/ui/touch_controls.cpp
new file mode 100644
index 0000000..8f903f0
--- /dev/null
+++ b/UnleashedRecomp/ui/touch_controls.cpp
@@ -0,0 +1,634 @@
+#include "touch_controls.h"
+
+#include <algorithm>
+#include <array>
+#include <cfloat>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+#include <imgui.h>
+
+#include <hid/hid.h>
+#include <sdl_listener.h>
+
+namespace
+{
+    constexpr SDL_FingerID NO_FINGER = -1;
+
+    enum class FaceSymbol
+    {
+        None,
+        Square,
+        Triangle,
+        Circle,
+        Cross
+    };
+
+    struct VirtualButton
+    {
+        ImVec2 centre{};
+        ImVec2 minimum{};
+        ImVec2 maximum{};
+        float drawRadius{};
+        float hitRadius{};
+        uint16_t buttonMask{};
+        FaceSymbol symbol{ FaceSymbol::None };
+        const char* label{};
+        SDL_FingerID fingerId{ NO_FINGER };
+        bool isCapsule{};
+        bool isRightTrigger{};
+        bool pressed{};
+    };
+
+    struct VirtualStick
+    {
+        ImVec2 centre{};
+        ImVec2 delta{};
+        float radius{};
+        float hitRadius{};
+        SDL_FingerID fingerId{ NO_FINGER };
+    };
+
+    enum ButtonIndex : size_t
+    {
+        BUTTON_SQUARE,
+        BUTTON_TRIANGLE,
+        BUTTON_CIRCLE,
+        BUTTON_CROSS,
+        BUTTON_L1,
+        BUTTON_R1,
+        BUTTON_R2,
+        BUTTON_COUNT
+    };
+
+    static VirtualStick g_leftStick;
+    static std::array<VirtualButton, BUTTON_COUNT> g_buttons;
+    static XAMINPUT_GAMEPAD g_gamepadState{};
+    static bool g_isActive;
+    static float g_viewportWidth = 1280.0f;
+    static float g_viewportHeight = 720.0f;
+
+    static float DistanceSquared(const ImVec2& a, const ImVec2& b)
+    {
+        const float x = a.x - b.x;
+        const float y = a.y - b.y;
+        return x * x + y * y;
+    }
+
+    static float ViewportWidth()
+    {
+        return g_viewportWidth;
+    }
+
+    static float ViewportHeight()
+    {
+        return g_viewportHeight;
+    }
+
+    static ImVec2 GetTouchPoint(const SDL_TouchFingerEvent& touch)
+    {
+        int drawableWidth = 0;
+        int drawableHeight = 0;
+
+        if (SDL_Window* window = SDL_GetWindowFromID(touch.windowID))
+            SDL_GetWindowSizeInPixels(window, &drawableWidth, &drawableHeight);
+
+        if (drawableWidth <= 0 || drawableHeight <= 0)
+            return { touch.x * ViewportWidth(), touch.y * ViewportHeight() };
+
+        const float offsetX = (float(drawableWidth) - ViewportWidth()) * 0.5f;
+        const float offsetY = (float(drawableHeight) - ViewportHeight()) * 0.5f;
+        return {
+            touch.x * float(drawableWidth) - offsetX,
+            touch.y * float(drawableHeight) - offsetY
+        };
+    }
+
+    static void ConfigureCircleButton(
+        ButtonIndex index,
+        const ImVec2& centre,
+        float drawRadius,
+        uint16_t buttonMask,
+        FaceSymbol symbol)
+    {
+        auto& button = g_buttons[index];
+        button.centre = centre;
+        button.drawRadius = drawRadius;
+        button.hitRadius = drawRadius * 1.42f;
+        button.buttonMask = buttonMask;
+        button.symbol = symbol;
+        button.label = nullptr;
+        button.isCapsule = false;
+        button.isRightTrigger = false;
+    }
+
+    static void ConfigureCapsuleButton(
+        ButtonIndex index,
+        const ImVec2& centre,
+        float width,
+        float height,
+        const char* label,
+        uint16_t buttonMask,
+        bool isRightTrigger = false)
+    {
+        auto& button = g_buttons[index];
+        button.centre = centre;
+        button.minimum = { centre.x - width * 0.5f, centre.y - height * 0.5f };
+        button.maximum = { centre.x + width * 0.5f, centre.y + height * 0.5f };
+        button.drawRadius = height * 0.5f;
+        button.hitRadius = 0.0f;
+        button.buttonMask = buttonMask;
+        button.symbol = FaceSymbol::None;
+        button.label = label;
+        button.isCapsule = true;
+        button.isRightTrigger = isRightTrigger;
+    }
+
+    static void UpdateLayout()
+    {
+        const float width = ViewportWidth();
+        const float height = ViewportHeight();
+        const float scale = std::max(0.5f, height / 720.0f);
+        const float edgeInset = std::max(44.0f * scale, width * 0.04f);
+        const float bottomInset = 44.0f * scale;
+
+        const float stickRadius = 84.0f * scale;
+        g_leftStick.centre = { edgeInset + stickRadius, height - bottomInset - stickRadius };
+        g_leftStick.radius = stickRadius;
+        g_leftStick.hitRadius = stickRadius * 1.38f;
+
+        const float faceRadius = 35.0f * scale;
+        const float faceGap = 73.0f * scale;
+        const ImVec2 faceCentre = {
+            width - edgeInset - faceRadius - faceGap,
+            height - bottomInset - faceRadius - faceGap
+        };
+
+        ConfigureCircleButton(BUTTON_SQUARE,
+            { faceCentre.x - faceGap, faceCentre.y }, faceRadius,
+            XAMINPUT_GAMEPAD_X, FaceSymbol::Square);
+        ConfigureCircleButton(BUTTON_TRIANGLE,
+            { faceCentre.x, faceCentre.y - faceGap }, faceRadius,
+            XAMINPUT_GAMEPAD_Y, FaceSymbol::Triangle);
+        ConfigureCircleButton(BUTTON_CIRCLE,
+            { faceCentre.x + faceGap, faceCentre.y }, faceRadius,
+            XAMINPUT_GAMEPAD_B, FaceSymbol::Circle);
+        ConfigureCircleButton(BUTTON_CROSS,
+            { faceCentre.x, faceCentre.y + faceGap }, faceRadius,
+            XAMINPUT_GAMEPAD_A, FaceSymbol::Cross);
+
+        const float shoulderWidth = 78.0f * scale;
+        const float shoulderHeight = 44.0f * scale;
+        const float shoulderGap = 10.0f * scale;
+        const float shoulderOffset = (shoulderWidth + shoulderGap) * 0.5f;
+        const float shoulderY = g_leftStick.centre.y - g_leftStick.radius - 54.0f * scale;
+
+        ConfigureCapsuleButton(BUTTON_L1,
+            { g_leftStick.centre.x - shoulderOffset, shoulderY },
+            shoulderWidth, shoulderHeight, "L1", XAMINPUT_GAMEPAD_LEFT_SHOULDER);
+        ConfigureCapsuleButton(BUTTON_R1,
+            { g_leftStick.centre.x + shoulderOffset, shoulderY },
+            shoulderWidth, shoulderHeight, "R1", XAMINPUT_GAMEPAD_RIGHT_SHOULDER);
+
+        ConfigureCapsuleButton(BUTTON_R2,
+            {
+                width - edgeInset - shoulderWidth * 0.5f,
+                faceCentre.y - faceGap * 1.48f
+            },
+            shoulderWidth, shoulderHeight, "R2", 0, true);
+    }
+
+    static bool HitTest(const VirtualButton& button, const ImVec2& point)
+    {
+        if (!button.isCapsule)
+            return DistanceSquared(button.centre, point) <= button.hitRadius * button.hitRadius;
+
+        const float padding = button.drawRadius * 0.35f;
+        return point.x >= button.minimum.x - padding && point.x <= button.maximum.x + padding &&
+            point.y >= button.minimum.y - padding && point.y <= button.maximum.y + padding;
+    }
+
+    static VirtualButton* FindButton(const ImVec2& point, SDL_FingerID fingerId)
+    {
+        VirtualButton* result = nullptr;
+        float nearestDistance = FLT_MAX;
+
+        for (auto& button : g_buttons)
+        {
+            if ((button.fingerId != NO_FINGER && button.fingerId != fingerId) || !HitTest(button, point))
+                continue;
+
+            const float distance = DistanceSquared(button.centre, point);
+            if (distance < nearestDistance)
+            {
+                nearestDistance = distance;
+                result = &button;
+            }
+        }
+
+        return result;
+    }
+
+    static void RebuildButtons()
+    {
+        g_gamepadState.wButtons = 0;
+        g_gamepadState.bRightTrigger = 0;
+
+        for (const auto& button : g_buttons)
+        {
+            if (!button.pressed)
+                continue;
+
+            if (button.isRightTrigger)
+                g_gamepadState.bRightTrigger = 255;
+            else
+                g_gamepadState.wButtons |= button.buttonMask;
+        }
+    }
+
+    static void ResetState()
+    {
+        g_gamepadState = {};
+        g_leftStick.delta = {};
+        g_leftStick.fingerId = NO_FINGER;
+
+        for (auto& button : g_buttons)
+        {
+            button.fingerId = NO_FINGER;
+            button.pressed = false;
+        }
+    }
+
+    static void SetStickPoint(const ImVec2& point)
+    {
+        ImVec2 delta = { point.x - g_leftStick.centre.x, point.y - g_leftStick.centre.y };
+        const float length = sqrtf(delta.x * delta.x + delta.y * delta.y);
+
+        if (length > g_leftStick.radius && length > 0.0f)
+        {
+            const float clampScale = g_leftStick.radius / length;
+            delta.x *= clampScale;
+            delta.y *= clampScale;
+        }
+
+        g_leftStick.delta = delta;
+        g_gamepadState.sThumbLX = int16_t(std::clamp(delta.x / g_leftStick.radius, -1.0f, 1.0f) * 32767.0f);
+        g_gamepadState.sThumbLY = int16_t(std::clamp(-delta.y / g_leftStick.radius, -1.0f, 1.0f) * 32767.0f);
+    }
+
+    static void MarkTouchInputActive()
+    {
+        hid::g_inputDevice = hid::EInputDevice::PlayStation;
+        hid::g_inputDeviceController = hid::EInputDevice::PlayStation;
+        hid::g_inputDeviceExplicit = hid::EInputDeviceExplicit::DualSense;
+        SDL_ShowCursor(SDL_DISABLE);
+    }
+
+    static bool HandleFingerDown(SDL_FingerID fingerId, const ImVec2& point)
+    {
+        if (auto* button = FindButton(point, fingerId))
+        {
+            button->fingerId = fingerId;
+            button->pressed = true;
+            RebuildButtons();
+            MarkTouchInputActive();
+            return true;
+        }
+
+        if (g_leftStick.fingerId == NO_FINGER &&
+            DistanceSquared(g_leftStick.centre, point) <= g_leftStick.hitRadius * g_leftStick.hitRadius)
+        {
+            g_leftStick.fingerId = fingerId;
+            SetStickPoint(point);
+            MarkTouchInputActive();
+            return true;
+        }
+
+        return false;
+    }
+
+    static bool HandleFingerMotion(SDL_FingerID fingerId, const ImVec2& point)
+    {
+        if (g_leftStick.fingerId == fingerId)
+        {
+            SetStickPoint(point);
+            return true;
+        }
+
+        const auto ownedButtonIterator = std::find_if(g_buttons.begin(), g_buttons.end(),
+            [fingerId](const VirtualButton& button) { return button.fingerId == fingerId; });
+        if (ownedButtonIterator == g_buttons.end())
+            return false;
+
+        auto* ownedButton = &*ownedButtonIterator;
+
+        if (HitTest(*ownedButton, point))
+            return true;
+
+        ownedButton->fingerId = NO_FINGER;
+        ownedButton->pressed = false;
+
+        if (auto* nextButton = FindButton(point, fingerId))
+        {
+            nextButton->fingerId = fingerId;
+            nextButton->pressed = true;
+        }
+
+        RebuildButtons();
+        return true;
+    }
+
+    static bool HandleFingerUp(SDL_FingerID fingerId)
+    {
+        if (g_leftStick.fingerId == fingerId)
+        {
+            g_leftStick.fingerId = NO_FINGER;
+            g_leftStick.delta = {};
+            g_gamepadState.sThumbLX = 0;
+            g_gamepadState.sThumbLY = 0;
+            return true;
+        }
+
+        bool released = false;
+        for (auto& button : g_buttons)
+        {
+            if (button.fingerId != fingerId)
+                continue;
+
+            button.fingerId = NO_FINGER;
+            button.pressed = false;
+            released = true;
+        }
+
+        if (released)
+            RebuildButtons();
+
+        return released;
+    }
+
+    static ImU32 WithAlpha(ImU32 colour, uint8_t alpha)
+    {
+        return (colour & IM_COL32(255, 255, 255, 0)) | (ImU32(alpha) << IM_COL32_A_SHIFT);
+    }
+
+    static ImU32 SymbolColour(FaceSymbol symbol)
+    {
+        switch (symbol)
+        {
+            case FaceSymbol::Square:
+                return IM_COL32(255, 126, 207, 255);
+            case FaceSymbol::Triangle:
+                return IM_COL32(87, 229, 157, 255);
+            case FaceSymbol::Circle:
+                return IM_COL32(255, 116, 137, 255);
+            case FaceSymbol::Cross:
+                return IM_COL32(104, 192, 255, 255);
+            default:
+                return IM_COL32_WHITE;
+        }
+    }
+
+    static void DrawFaceSymbol(ImDrawList* drawList, const VirtualButton& button, float scale)
+    {
+        const ImU32 colour = WithAlpha(SymbolColour(button.symbol), button.pressed ? 255 : 220);
+        const float size = button.drawRadius * 0.39f;
+        const float thickness = 3.0f * scale;
+        const ImVec2 centre = button.centre;
+
+        switch (button.symbol)
+        {
+            case FaceSymbol::Square:
+                drawList->AddRect(
+                    { centre.x - size, centre.y - size },
+                    { centre.x + size, centre.y + size },
+                    colour, 1.5f * scale, 0, thickness);
+                break;
+
+            case FaceSymbol::Triangle:
+                drawList->AddTriangle(
+                    { centre.x, centre.y - size * 1.15f },
+                    { centre.x - size, centre.y + size * 0.82f },
+                    { centre.x + size, centre.y + size * 0.82f },
+                    colour, thickness);
+                break;
+
+            case FaceSymbol::Circle:
+                drawList->AddCircle(centre, size, colour, 32, thickness);
+                break;
+
+            case FaceSymbol::Cross:
+                drawList->AddLine(
+                    { centre.x - size, centre.y - size },
+                    { centre.x + size, centre.y + size }, colour, thickness);
+                drawList->AddLine(
+                    { centre.x + size, centre.y - size },
+                    { centre.x - size, centre.y + size }, colour, thickness);
+                break;
+
+            default:
+                break;
+        }
+    }
+
+    static void DrawFaceButton(ImDrawList* drawList, const VirtualButton& button, float scale)
+    {
+        const ImU32 fill = button.pressed ? IM_COL32(61, 127, 205, 178) : IM_COL32(17, 24, 39, 96);
+        const ImU32 border = button.pressed ? IM_COL32(205, 233, 255, 245) : IM_COL32(224, 233, 246, 158);
+
+        if (button.pressed)
+            drawList->AddCircleFilled(button.centre, button.drawRadius + 5.0f * scale, IM_COL32(89, 176, 255, 46), 36);
+
+        drawList->AddCircleFilled(button.centre, button.drawRadius, fill, 36);
+        drawList->AddCircle(button.centre, button.drawRadius, border, 36, 2.0f * scale);
+        DrawFaceSymbol(drawList, button, scale);
+    }
+
+    static void DrawCapsuleButton(ImDrawList* drawList, const VirtualButton& button, float scale)
+    {
+        const ImU32 fill = button.pressed ? IM_COL32(61, 127, 205, 190) : IM_COL32(17, 24, 39, 108);
+        const ImU32 border = button.pressed ? IM_COL32(205, 233, 255, 245) : IM_COL32(224, 233, 246, 170);
+        const float rounding = button.drawRadius;
+
+        if (button.pressed)
+        {
+            drawList->AddRectFilled(
+                { button.minimum.x - 4.0f * scale, button.minimum.y - 4.0f * scale },
+                { button.maximum.x + 4.0f * scale, button.maximum.y + 4.0f * scale },
+                IM_COL32(89, 176, 255, 44), rounding + 4.0f * scale);
+        }
+
+        drawList->AddRectFilled(button.minimum, button.maximum, fill, rounding);
+        drawList->AddRect(button.minimum, button.maximum, border, rounding, 0, 2.0f * scale);
+
+        const ImFont* font = ImGui::GetFont();
+        const float fontSize = 17.0f * scale;
+        const ImVec2 textSize = font->CalcTextSizeA(fontSize, FLT_MAX, 0.0f, button.label);
+        drawList->AddText(
+            font,
+            fontSize,
+            { button.centre.x - textSize.x * 0.5f, button.centre.y - textSize.y * 0.5f },
+            IM_COL32(240, 246, 255, 235),
+            button.label);
+    }
+
+    static void DrawStick(ImDrawList* drawList, float scale)
+    {
+        const bool pressed = g_leftStick.fingerId != NO_FINGER;
+        const ImVec2 knobCentre = {
+            g_leftStick.centre.x + g_leftStick.delta.x,
+            g_leftStick.centre.y + g_leftStick.delta.y
+        };
+
+        drawList->AddCircleFilled(g_leftStick.centre, g_leftStick.radius, IM_COL32(17, 24, 39, 78), 48);
+        drawList->AddCircle(g_leftStick.centre, g_leftStick.radius, IM_COL32(224, 233, 246, 145), 48, 2.0f * scale);
+        drawList->AddCircle(g_leftStick.centre, g_leftStick.radius * 0.58f, IM_COL32(224, 233, 246, 55), 40, 1.5f * scale);
+
+        if (pressed)
+            drawList->AddCircleFilled(knobCentre, g_leftStick.radius * 0.39f, IM_COL32(89, 176, 255, 72), 36);
+
+        drawList->AddCircleFilled(
+            knobCentre,
+            g_leftStick.radius * 0.31f,
+            pressed ? IM_COL32(164, 218, 255, 218) : IM_COL32(231, 238, 248, 178),
+            36);
+        drawList->AddCircle(
+            knobCentre,
+            g_leftStick.radius * 0.31f,
+            IM_COL32(255, 255, 255, 205),
+            36,
+            1.5f * scale);
+    }
+
+    class TouchEventListener : public SDLEventListener
+    {
+    public:
+        bool OnSDLEvent(SDL_Event* event) override
+        {
+            if (event->type == SDL_APP_WILLENTERBACKGROUND ||
+                (event->type == SDL_WINDOWEVENT && event->window.event == SDL_WINDOWEVENT_FOCUS_LOST))
+            {
+                ResetState();
+                return false;
+            }
+
+            if (!TouchControls::IsActive())
+                return false;
+
+            UpdateLayout();
+
+            switch (event->type)
+            {
+                case SDL_FINGERDOWN:
+                    return HandleFingerDown(event->tfinger.fingerId, GetTouchPoint(event->tfinger));
+
+                case SDL_FINGERMOTION:
+                    return HandleFingerMotion(event->tfinger.fingerId, GetTouchPoint(event->tfinger));
+
+                case SDL_FINGERUP:
+                    return HandleFingerUp(event->tfinger.fingerId);
+
+                default:
+                    return false;
+            }
+        }
+    };
+
+    static TouchEventListener g_touchEventListener;
+}
+
+void TouchControls::Init()
+{
+    g_isActive = false;
+    UpdateLayout();
+    ResetState();
+}
+
+void TouchControls::SetActive(bool active)
+{
+    // Poll the HID driver's already-open controller handles every rendered
+    // frame. A DualSense connection hides and releases the touch overlay; the
+    // overlay becomes active again on the first frame after disconnection.
+    active = active && !hid::IsDualSenseConnected();
+
+    if (g_isActive && !active)
+        ResetState();
+
+    g_isActive = active;
+}
+
+bool TouchControls::IsActive()
+{
+#ifdef UNLEASHED_RECOMP_IOS
+    return g_isActive;
+#else
+    return false;
+#endif
+}
+
+bool TouchControls::CapturesEmulatedMouse(const SDL_Event* event)
+{
+    if (!IsActive() || !event)
+        return false;
+
+    switch (event->type)
+    {
+        case SDL_MOUSEBUTTONDOWN:
+        case SDL_MOUSEBUTTONUP:
+            return event->button.which == SDL_TOUCH_MOUSEID;
+
+        case SDL_MOUSEMOTION:
+            return event->motion.which == SDL_TOUCH_MOUSEID;
+
+        default:
+            return false;
+    }
+}
+
+XAMINPUT_GAMEPAD TouchControls::GetState()
+{
+    return g_gamepadState;
+}
+
+void TouchControls::ApplyToState(XAMINPUT_GAMEPAD& state)
+{
+    const auto touchState = GetState();
+    state.wButtons |= touchState.wButtons;
+    state.bLeftTrigger = std::max(state.bLeftTrigger, touchState.bLeftTrigger);
+    state.bRightTrigger = std::max(state.bRightTrigger, touchState.bRightTrigger);
+
+    if (touchState.sThumbLX != 0 || touchState.sThumbLY != 0)
+    {
+        state.sThumbLX = touchState.sThumbLX;
+        state.sThumbLY = touchState.sThumbLY;
+    }
+}
+
+void TouchControls::Draw()
+{
+    if (!IsActive())
+        return;
+
+    const ImVec2 displaySize = ImGui::GetIO().DisplaySize;
+    if (displaySize.x > 0.0f && displaySize.y > 0.0f)
+    {
+        g_viewportWidth = displaySize.x;
+        g_viewportHeight = displaySize.y;
+    }
+
+    UpdateLayout();
+
+    const float scale = std::max(0.5f, ViewportHeight() / 720.0f);
+    ImDrawList* drawList = ImGui::GetForegroundDrawList();
+
+    DrawStick(drawList, scale);
+
+    for (const auto& button : g_buttons)
+    {
+        if (button.isCapsule)
+            DrawCapsuleButton(drawList, button, scale);
+        else
+            DrawFaceButton(drawList, button, scale);
+    }
+}
