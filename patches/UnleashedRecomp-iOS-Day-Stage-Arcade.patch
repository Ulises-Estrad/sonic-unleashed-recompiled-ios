+std::filesystem::path GetGamePath()
+{
+#if defined(__APPLE__)
+#if TARGET_OS_IPHONE
+    const std::filesystem::path bundledGamePath = apple::GetBundleResourceDirectory() / "GameData";
+    if (std::filesystem::exists(bundledGamePath / "game" / "default.xex") &&
+        std::filesystem::exists(bundledGamePath / "update" / "default.xexp") &&
+        std::filesystem::exists(bundledGamePath / "patched" / "default.xex"))
+    {
+        return bundledGamePath;
+    }
+#endif
+
+    // Apple app bundles are read-only. Non-bundled installs remain in the
+    // user directory, preserving the existing Finder/Files import workflow.
+    return GetUserPath();
+#else
+    return GAME_INSTALL_DIRECTORY;
+#endif
+}
+
+bool SeedBundledSaveData()
+{
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+    const std::filesystem::path bundledSavePath = GetGamePath() / "save";
+    if (!std::filesystem::exists(bundledSavePath) || bundledSavePath == (GetUserPath() / "save"))
+        return true;
+
+    const std::filesystem::path userSavePath = GetUserPath() / "save";
+    std::error_code ec;
+    std::filesystem::create_directories(userSavePath, ec);
+    if (ec)
+        return false;
+
+    for (std::filesystem::recursive_directory_iterator it(bundledSavePath, ec), end; it != end && !ec; it.increment(ec))
+    {
+        const std::filesystem::path relativePath = std::filesystem::relative(it->path(), bundledSavePath, ec);
+        if (ec)
+            break;
+
+        const std::filesystem::path destinationPath = userSavePath / relativePath;
+        if (it->is_directory(ec))
+        {
+            std::filesystem::create_directories(destinationPath, ec);
+        }
+        else if (it->is_regular_file(ec) && !std::filesystem::exists(destinationPath))
+        {
+            std::filesystem::create_directories(destinationPath.parent_path(), ec);
+            if (!ec)
+                std::filesystem::copy_file(it->path(), destinationPath, std::filesystem::copy_options::none, ec);
+        }
+    }
+
+    return !ec;
+#else
+    return true;
+#endif
+}
+
+bool PrepareArcadeSaveData()
+{
+#if defined(UNLEASHED_RECOMP_DAY_STAGE_ARCADE)
+    const std::filesystem::path savePath = GetUserPath() / "save" / "SYS-DATA";
+    if (!std::filesystem::is_regular_file(savePath))
+        return false;
+
+    std::ifstream input(savePath, std::ios::binary | std::ios::ate);
+    if (!input.good() || input.tellg() < 0x20)
+        return false;
+
+    const std::streamsize size = input.tellg();
+    input.seekg(0, std::ios::beg);
+    std::vector<uint8_t> data(size);
+    if (!input.read(reinterpret_cast<char*>(data.data()), size))
+        return false;
+    input.close();
+
+    // The raw Xbox save payload stores the allocated daytime stat points as
+    // big-endian u32 values. Eight Speed points yields level 11 and four Ring
+    // Energy points yields level 6, the maxima from SkillParameter.xml.
+    auto readBigEndian = [&](size_t offset)
+    {
+        return uint32_t(data[offset]) << 24 |
+            uint32_t(data[offset + 1]) << 16 |
+            uint32_t(data[offset + 2]) << 8 |
+            uint32_t(data[offset + 3]);
+    };
+
+    auto writeBigEndian = [&](size_t offset, uint32_t value)
+    {
+        data[offset] = uint8_t(value >> 24);
+        data[offset + 1] = uint8_t(value >> 16);
+        data[offset + 2] = uint8_t(value >> 8);
+        data[offset + 3] = uint8_t(value);
+    };
+
+    bool changed = false;
+    if (readBigEndian(0x10) < 8)
+    {
+        writeBigEndian(0x10, 8);
+        changed = true;
+    }
+    if (readBigEndian(0x1C) < 4)
+    {
+        writeBigEndian(0x1C, 4);
+        changed = true;
+    }
+    if (!changed)
+        return true;
+
+    const std::filesystem::path backupPath = savePath.parent_path() / "SYS-DATA.pre-arcade";
+    std::error_code ec;
+    if (!std::filesystem::exists(backupPath))
+    {
+        std::filesystem::copy_file(savePath, backupPath, std::filesystem::copy_options::none, ec);
+        if (ec)
+            return false;
+    }
+
+    std::ofstream output(savePath, std::ios::binary | std::ios::trunc);
+    if (!output.good())
+        return false;
+    output.write(reinterpret_cast<const char*>(data.data()), data.size());
+    return output.good();
+#else
+    return true;
+#endif
+}
