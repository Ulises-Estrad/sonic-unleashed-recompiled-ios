+
+namespace
+{
+    std::mutex g_diagnosticMutex;
+    FILE* g_diagnosticFile = nullptr;
+    size_t g_diagnosticBytes = 0;
+    constexpr size_t DiagnosticLimit = 4 * 1024 * 1024;
+}
 #endif
 void os::logger::Init()
 {
+#if TARGET_OS_IPHONE
+    // Unified logging may discard messages during startup. Keep a bounded,
+    // app-owned copy retrievable through Files/AFC, including Metal's stderr.
+    std::lock_guard lock(g_diagnosticMutex);
+    const auto& directory = GetUserPath();
+    std::error_code ec;
+    std::filesystem::create_directories(directory, ec);
+    if (ec)
+        return;
+
+    for (const char* name : { "Sonic-Unleashed-diagnostic.log", "Sonic-Unleashed-stderr.log" })
+    {
+        const auto path = directory / name;
+        if (std::filesystem::is_regular_file(path, ec))
+            std::filesystem::copy_file(path, path.string() + ".previous",
+                std::filesystem::copy_options::overwrite_existing, ec);
+        ec.clear();
+    }
+
+    g_diagnosticFile = std::fopen((directory / "Sonic-Unleashed-diagnostic.log").c_str(), "w");
+    g_diagnosticBytes = 0;
+    if (std::freopen((directory / "Sonic-Unleashed-stderr.log").c_str(), "w", stderr))
+        std::setvbuf(stderr, nullptr, _IONBF, 0);
+#endif
 }
 
